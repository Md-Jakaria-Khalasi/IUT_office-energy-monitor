# Office Energy Monitor — Backend configuration
# Copy this file to `backend/.env` and adjust for your environment.

# --- Application ---
DEBUG=true
ENVIRONMENT=development
APP_NAME=Office Energy Monitoring System

# --- HTTP server ---
HOST=0.0.0.0
PORT=8000
# Set to true for `uvicorn --reload` development server.
RELOAD=false
LOG_LEVEL=INFO

# --- Database ---
# Async SQLAlchemy URL. sqlite+aiosqlite for dev; swap to Postgres later.
DATABASE_URL=sqlite+aiosqlite:///./office_energy.db

# --- CORS ---
# Comma-separated list of allowed origins for the Flutter web dashboard.
# Use "*" only for local dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080,*

# --- Simulation engine ---
SIMULATION_INTERVAL_SECONDS=5
SIMULATION_ENABLED=true

# --- Office hours gate ---
# Devices cannot be turned on outside these hours (24-hour clock).
OFFICE_START_HOUR=8
OFFICE_END_HOUR=18
OFFICE_TIMEZONE=UTC

# --- Alert thresholds ---
# Aggregate wattage above which a usage alert is raised.
ALERT_WATT_THRESHOLD=1500
# Allow alerts to fire outside office hours too (simulator events).
ALERT_OFF_HOURS_ACTIVE=true