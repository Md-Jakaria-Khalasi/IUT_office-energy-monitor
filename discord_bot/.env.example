# ---------------------------------------------------------------------------
# Office Energy Monitor — Discord bot configuration
# Copy this file to `.env` and fill in your real values.
# ---------------------------------------------------------------------------

# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
COMMAND_PREFIX=!

# --- Backend ---------------------------------------------------------------
# Base URL of the FastAPI backend (no trailing slash).
BACKEND_URL=http://localhost:8000
# API prefix the backend exposes. Defaults to /api/v1; change if yours differs.
BACKEND_API_PREFIX=/api/v1
# Per-request HTTP timeout in seconds.
REQUEST_TIMEOUT_SECONDS=10

# --- Alert watcher ---------------------------------------------------------
# Channel ID where new alerts are posted automatically.
# Leave empty (or unset) to disable automatic notifications.
ALERT_CHANNEL_ID=
# How often (seconds) to poll /alerts for new entries.
POLL_INTERVAL_SECONDS=30
# Maximum number of alerts fetched per poll cycle.
ALERT_POLL_LIMIT=50

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO